{
  "$schema": "https://opencode.ai/config.json",

  // WEFT agent contract.
  // Model-agnostic: no "model" key anywhere. Fady selects the session model.
  // Permission rules are ordered; last matching rule wins.
  // Skills: default-deny, explicit allow/ask. Nothing is deleted from disk.

  "permissions": [
    // ── Baseline ────────────────────────────────────────────────────
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },

    // ── Skills: allow — Matt Pocock process spine ───────────────────
    { "action": "skill", "resource": "setup-matt-pocock-skills", "effect": "allow" },
    { "action": "skill", "resource": "grill-with-docs", "effect": "allow" },
    { "action": "skill", "resource": "grilling", "effect": "allow" },
    { "action": "skill", "resource": "to-spec", "effect": "allow" },
    { "action": "skill", "resource": "to-tickets", "effect": "allow" },
    { "action": "skill", "resource": "implement", "effect": "allow" },
    { "action": "skill", "resource": "code-review", "effect": "allow" },
    { "action": "skill", "resource": "pr", "effect": "allow" },
    { "action": "skill", "resource": "triage", "effect": "allow" },
    { "action": "skill", "resource": "retro", "effect": "allow" },
    { "action": "skill", "resource": "improve-codebase-architecture", "effect": "allow" },
    { "action": "skill", "resource": "diagnosing-bugs", "effect": "allow" },
    { "action": "skill", "resource": "wizard", "effect": "allow" },
    { "action": "skill", "resource": "domain-modeling", "effect": "allow" },
    { "action": "skill", "resource": "codebase-design", "effect": "allow" },
    { "action": "skill", "resource": "writing-for-agents", "effect": "allow" },
    { "action": "skill", "resource": "tdd", "effect": "allow" },

    // ── Skills: allow — official Dart/Flutter helpers ───────────────
    { "action": "skill", "resource": "dart-add-unit-test", "effect": "allow" },
    { "action": "skill", "resource": "dart-collect-coverage", "effect": "allow" },
    { "action": "skill", "resource": "dart-run-static-analysis", "effect": "allow" },
    { "action": "skill", "resource": "dart-generate-test-mocks", "effect": "allow" },
    { "action": "skill", "resource": "dart-use-pattern-matching", "effect": "allow" },
    { "action": "skill", "resource": "dart-write-documentation", "effect": "allow" },
    { "action": "skill", "resource": "dart-use-path-package", "effect": "allow" },
    { "action": "skill", "resource": "dart-fix-runtime-errors", "effect": "allow" },
    { "action": "skill", "resource": "dart-resolve-package-conflicts", "effect": "allow" },
    { "action": "skill", "resource": "dart-migrate-to-checks-package", "effect": "allow" },
    { "action": "skill", "resource": "flutter-apply-architecture-best-practices", "effect": "allow" },
    { "action": "skill", "resource": "flutter-add-integration-test", "effect": "allow" },

    // ── Skills: allow — curated project helpers ─────────────────────
    { "action": "skill", "resource": "golang-patterns", "effect": "allow" },
    { "action": "skill", "resource": "golang-testing", "effect": "allow" },
    { "action": "skill", "resource": "postgres-patterns", "effect": "allow" },
    { "action": "skill", "resource": "database-migrations", "effect": "allow" },
    { "action": "skill", "resource": "benchmark-methodology", "effect": "allow" },
    { "action": "skill", "resource": "architecture-decision-records", "effect": "allow" },

    // ── Skills: ask — situational, human approves each load ─────────
    { "action": "skill", "resource": "coding-standards", "effect": "ask" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "ask" },
    { "action": "skill", "resource": "latency-critical-systems", "effect": "ask" },
    { "action": "skill", "resource": "docker-patterns", "effect": "ask" },
    { "action": "skill", "resource": "github-ops", "effect": "ask" },
    { "action": "skill", "resource": "mermaid-expert", "effect": "ask" },
    { "action": "skill", "resource": "dart-flutter-patterns", "effect": "ask" },
    { "action": "skill", "resource": "flutter-testing-apps", "effect": "ask" },
    { "action": "skill", "resource": "e2e-testing", "effect": "ask" },
    { "action": "skill", "resource": "hexagonal-architecture", "effect": "ask" },
    { "action": "skill", "resource": "handoff", "effect": "ask" },
    { "action": "skill", "resource": "research", "effect": "ask" },
    { "action": "skill", "resource": "ask-matt", "effect": "ask" },
    { "action": "skill", "resource": "prototype", "effect": "ask" },
    { "action": "skill", "resource": "teach", "effect": "ask" },
    { "action": "skill", "resource": "to-questionnaire", "effect": "ask" },
    { "action": "skill", "resource": "wait-what", "effect": "ask" },
    { "action": "skill", "resource": "grill-me", "effect": "ask" },

    // ── Shell: routine project commands ─────────────────────────────
    { "action": "shell", "resource": "just", "effect": "allow" },
    { "action": "shell", "resource": "just *", "effect": "allow" },
    { "action": "shell", "resource": "dart *", "effect": "allow" },
    { "action": "shell", "resource": "flutter *", "effect": "allow" },
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    { "action": "shell", "resource": "govulncheck *", "effect": "allow" },
    { "action": "shell", "resource": "git-cliff *", "effect": "allow" },
    { "action": "shell", "resource": "gitleaks *", "effect": "allow" },
    { "action": "shell", "resource": "lefthook *", "effect": "allow" },
    { "action": "shell", "resource": "shfmt *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    { "action": "shell", "resource": "hadolint *", "effect": "allow" },
    { "action": "shell", "resource": "actionlint *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose *", "effect": "allow" },
    { "action": "shell", "resource": "docker build *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps*", "effect": "allow" },
    { "action": "shell", "resource": "docker logs*", "effect": "allow" },
    { "action": "shell", "resource": "docker images*", "effect": "allow" },
    { "action": "shell", "resource": "adb devices", "effect": "allow" },
    { "action": "shell", "resource": "adb install *", "effect": "allow" },
    { "action": "shell", "resource": "adb shell svc wifi *", "effect": "allow" },
    { "action": "shell", "resource": "adb shell svc data *", "effect": "allow" },
    { "action": "shell", "resource": "adb shell cmd connectivity *", "effect": "allow" },
    { "action": "shell", "resource": "adb logcat *", "effect": "allow" },

    // ── Shell: git inspection and feature-branch writes ─────────────
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull --ff-only*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin feat-*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin fix-*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin chore-*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin docs-*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin spike-*", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin feat-*", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin fix-*", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin chore-*", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin docs-*", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin spike-*", "effect": "allow" },
    { "action": "shell", "resource": "git push --set-upstream origin feat-*", "effect": "allow" },
    { "action": "shell", "resource": "git push --set-upstream origin fix-*", "effect": "allow" },
    { "action": "shell", "resource": "git push --set-upstream origin chore-*", "effect": "allow" },
    { "action": "shell", "resource": "git push --set-upstream origin docs-*", "effect": "allow" },
    { "action": "shell", "resource": "git push --set-upstream origin spike-*", "effect": "allow" },

    // ── Shell: GitHub tracker / PR inspection and creation ──────────
    { "action": "shell", "resource": "gh issue *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "gh label *", "effect": "allow" },

    // ── Critical denies: secrets, main, releases, destructive ops ───
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/*.p12", "effect": "deny" },
    { "action": "read", "resource": "**/*.jks", "effect": "deny" },
    { "action": "read", "resource": "**/*.keystore", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": ".env", "effect": "deny" },
    { "action": "edit", "resource": ".env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" },
    { "action": "edit", "resource": "**/*.pem", "effect": "deny" },
    { "action": "edit", "resource": "**/*.p12", "effect": "deny" },
    { "action": "edit", "resource": "**/*.jks", "effect": "deny" },
    { "action": "edit", "resource": "**/*.keystore", "effect": "deny" },
    { "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.git/**", "effect": "deny" },

    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "echo $*", "effect": "deny" },
    { "action": "shell", "resource": "cat .env*", "effect": "deny" },
    { "action": "shell", "resource": "gh secret*", "effect": "deny" },
    { "action": "shell", "resource": "gh variable*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth token*", "effect": "deny" },
    { "action": "shell", "resource": "gh api*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh release*", "effect": "deny" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh workflow run*", "effect": "deny" },
    { "action": "shell", "resource": "git tag*", "effect": "deny" },
    { "action": "shell", "resource": "git push origin main", "effect": "deny" },
    { "action": "shell", "resource": "git push origin master", "effect": "deny" },
    { "action": "shell", "resource": "git push origin HEAD:main", "effect": "deny" },
    { "action": "shell", "resource": "git push origin *:main", "effect": "deny" },
    { "action": "shell", "resource": "git push --all*", "effect": "deny" },
    { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push origin :*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "age *", "effect": "deny" },
    { "action": "shell", "resource": "rclone *", "effect": "deny" },
    { "action": "shell", "resource": "psql *", "effect": "deny" },
    { "action": "shell", "resource": "docker system prune*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume rm*", "effect": "deny" },
    { "action": "shell", "resource": "curl * -X POST*", "effect": "deny" },
    { "action": "shell", "resource": "curl * --request POST*", "effect": "deny" },
    { "action": "shell", "resource": "wget --post*", "effect": "deny" },

    // ── Explicit skill denies: conflicts with locked decisions ──────
    { "action": "skill", "resource": "flutter-add-widget-test", "effect": "deny" },
    { "action": "skill", "resource": "dart-setup-ffi-assets", "effect": "deny" },
    { "action": "skill", "resource": "dart-use-ffigen", "effect": "deny" },
    { "action": "skill", "resource": "flutter-implement-json-serialization", "effect": "deny" },
    { "action": "skill", "resource": "flutter-setup-declarative-routing", "effect": "deny" },
    { "action": "skill", "resource": "flutter-use-http-package", "effect": "deny" },
    { "action": "skill", "resource": "flutter-setup-localization", "effect": "deny" },
    { "action": "skill", "resource": "flutter-build-responsive-layout", "effect": "deny" },
    { "action": "skill", "resource": "flutter-fix-layout-issues", "effect": "deny" },
    { "action": "skill", "resource": "flutter-add-widget-preview", "effect": "deny" },
    { "action": "skill", "resource": "dart-build-cli-app", "effect": "deny" },
    { "action": "skill", "resource": "dart-use-doc-examples", "effect": "deny" },
    { "action": "skill", "resource": "dart-use-primary-constructors", "effect": "deny" },
    { "action": "skill", "resource": "wayfinder", "effect": "deny" },
    { "action": "skill", "resource": "implement-spec", "effect": "deny" },
    { "action": "skill", "resource": "spec-kit", "effect": "deny" },
    { "action": "skill", "resource": "specify", "effect": "deny" },
    { "action": "skill", "resource": "egm*", "effect": "deny" },
    { "action": "skill", "resource": "artemis*", "effect": "deny" }
  ],

  "agents": {
    "standards-reviewer": {
      "description": "Read-only standards review for /code-review. No edits, no merges, no secrets.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "coding-standards", "effect": "allow" },
        { "action": "skill", "resource": "dart-run-static-analysis", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "just lint*", "effect": "allow" },
        { "action": "shell", "resource": "just test*", "effect": "allow" },
        { "action": "shell", "resource": "dart analyze*", "effect": "allow" },
        { "action": "shell", "resource": "dart test*", "effect": "allow" },
        { "action": "shell", "resource": "go vet*", "effect": "allow" },
        { "action": "shell", "resource": "go test*", "effect": "allow" },
        { "action": "shell", "resource": "flutter analyze*", "effect": "allow" },
        { "action": "shell", "resource": "flutter test*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "spec-reviewer": {
      "description": "Read-only spec-faithfulness review for /code-review. Checks diff against PRD/tickets only.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
        { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  }
}